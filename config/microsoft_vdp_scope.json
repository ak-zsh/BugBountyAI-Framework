{
  "program": {
    "name": "Microsoft MSRC VDP",
    "platform": "Microsoft Security Response Center",
    "type": "VDP",
    "authorization": "Public Disclosure Program",
    "link": "https://msrc.microsoft.com/vulnerability-disclosure"
  },
  
  "target": "microsoft.com",
  
  "domain_scope": {
    "in_scope_domains": [
      "microsoft.com",
      "*.microsoft.com",
      "*.office.com",
      "*.outlook.com",
      "*.azure.com",
      "*.github.com",
      "*.windows.net",
      "*.powershell.com"
    ],
    "out_of_scope_domains": [
      "*.test.microsoft.com",
      "internal.microsoft.com",
      "private.microsoft.com"
    ]
  },
  
  "vulnerability_scope": {
    "in_scope_vulns": [
      "XSS",
      "CSRF",
      "SQLi",
      "RCE",
      "Authentication Bypass",
      "Authorization Bypass",
      "Information Disclosure",
      "SSRF",
      "XXE",
      "Deserialization",
      "Path Traversal",
      "Command Injection",
      "Logic Bugs",
      "Cryptographic Weaknesses",
      "Insecure Direct Object References (IDOR)"
    ],
    "out_of_scope_vulns": [
      "Social Engineering",
      "Phishing",
      "Physical Security",
      "Brute Force (low-hanging)",
      "Clickjacking",
      "Rate Limiting Bypass",
      "Public CVE Reproduction",
      "Non-Security Issues"
    ]
  },
  
  "testing_restrictions": {
    "blocked_paths": [
      "/admin",
      "/internal",
      "/api/internal",
      "/debug",
      "/test",
      "/staging",
      "/*-internal*",
      "/employee/*",
      "/corporate/*"
    ],
    "blocked_methods": [
      "DoS",
      "DDoS",
      "Data Exfiltration",
      "Account Takeover (except your own test account)",
      "Production Data Manipulation",
      "Email Spoofing",
      "DNS Hijacking"
    ]
  },
  
  "rate_limits": {
    "requests_per_second": 5,
    "requests_per_minute": 300,
    "concurrent_connections": 2,
    "description": "Respectful rate limiting to avoid DoS detection"
  },
  
  "authentication": {
    "auth_required": false,
    "test_account_only": true,
    "note": "Do NOT test against other users' accounts without permission"
  },
  
  "special_conditions": {
    "no_personal_data_collection": true,
    "no_user_data_exfiltration": true,
    "respect_privacy": true,
    "comply_with_gdpr": true,
    "log_all_actions": true
  },
  
  "reporting": {
    "disclosure_period": "90 days",
    "platform": "MSRC Submission Form",
    "report_url": "https://msrc.microsoft.com/create-report",
    "email": "secure@microsoft.com"
  },
  
  "contact": {
    "program_name": "Microsoft MSRC",
    "website": "https://www.microsoft.com/en-us/msrc",
    "policy": "https://www.microsoft.com/en-us/msrc/cvd"
  }
}
